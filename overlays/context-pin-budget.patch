@@ -0,0 +1,694 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import type { ComboLike, SingleModelTarget } from "../../open-sse/services/combo/types.ts";
+
+const dataDir = fs.mkdtempSync(path.join(os.tmpdir(), "omniroute-context-pin-budget-"));
+process.env.DATA_DIR = dataDir;
+process.env.API_KEY_SECRET = "unit-test-context-pin-budget-secret";
+process.env.DISABLE_SQLITE_AUTO_BACKUP = "true";
+
+const { handleComboChat } = await import("../../open-sse/services/combo.ts");
+const { recordSessionModelUsage } = await import("../../src/lib/db/contextHandoffs.ts");
+const { scopeHandoffSessionId } =
+  await import("../../open-sse/services/combo/handoffSessionScope.ts");
+const { createProviderConnection } = await import("../../src/lib/db/providers.ts");
+const { invalidateDbCache } = await import("../../src/lib/db/readCache.ts");
+const { resetDbInstance } = await import("../../src/lib/db/core.ts");
+const { clearSessions } = await import("../../open-sse/services/sessionManager.ts");
+const { resetAllCircuitBreakers } = await import("../../src/shared/utils/circuitBreaker.ts");
+const { clearAllModelLockouts } = await import("../../open-sse/services/accountFallback.ts");
+
+const noop = () => {};
+const log = { info: noop, warn: noop, debug: noop, error: noop };
+
+test.after(async () => {
+  await new Promise<void>((resolve) => setImmediate(resolve));
+  clearSessions();
+  resetAllCircuitBreakers();
+  clearAllModelLockouts();
+  resetDbInstance();
+  fs.rmSync(dataDir, { recursive: true, force: true });
+});
+
+function response(status: number) {
+  const body =
+    status === 200
+      ? { choices: [{ message: { content: "A complete fixture response." } }] }
+      : { error: { message: "Fixture temporarily unavailable", code: "upstream_error" } };
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "Content-Type": "application/json" },
+  });
+}
+
+async function runCase(
+  tag: string,
+  options: {
+    pinResult?:
+      | "success"
+      | "503"
+      | "402"
+      | "429-quota"
+      | "401"
+      | "stall"
+      | "empty"
+      | "slow-json"
+      | "slow-error"
+      | "silent-stream"
+      | "timeout";
+    provider?: string;
+    binding?: "unique" | "dynamic" | "pool" | "separate-accounts";
+    selectedHeader?: boolean;
+    succeedPinOnAttempt?: number;
+    failFallback?: boolean;
+    holdFallback?: boolean;
+    fallbackCompleteMs?: number;
+    body?: Record<string, unknown>;
+    pinDelayMs?: number;
+    protectedPin?: boolean;
+    abort?: "before" | "during";
+    config?: Record<string, unknown>;
+    pinHistory?: boolean;
+    onPinAttempt?: () => void;
+    cooldownRecovery?: boolean;
+  } = {}
+) {
+  resetAllCircuitBreakers();
+  clearAllModelLockouts();
+  const provider = options.provider ?? "pinbudget";
+  const pinModel = `${provider}/pin-${tag}`;
+  const fallbackModel = `pinbudgetfallback/healthy-${tag}`;
+  const pinAccount = await createProviderConnection({
+    provider,
+    authType: "api-key",
+    name: `pin-${tag}`,
+    apiKey: "test-only-provider-credential",
+    isActive: true,
+  });
+  const fallbackAccount = await createProviderConnection({
+    provider: "pinbudgetfallback",
+    authType: "api-key",
+    name: `fallback-${tag}`,
+    apiKey: "test-only-provider-credential",
+    isActive: true,
+  });
+  const siblingAccount = await createProviderConnection({
+    provider,
+    authType: "api-key",
+    name: `sibling-${tag}`,
+    apiKey: "test-only-provider-credential",
+    isActive: true,
+  });
+  invalidateDbCache();
+  const sessionId = `pin-budget-${tag}`;
+  const combo: ComboLike = {
+    name: `context-pin-budget-${tag}`,
+    strategy: "priority",
+    context_cache_protection: true,
+    models: [
+      {
+        model: pinModel,
+        ...(options.binding === "dynamic"
+          ? {}
+          : options.binding === "pool"
+            ? { allowedConnectionIds: [pinAccount.id, siblingAccount.id] }
+            : { connectionId: pinAccount.id }),
+        fallbackOnlyOnQuotaExhaustion: options.protectedPin === true,
+      },
+      ...(options.binding === "separate-accounts"
+        ? [{ model: pinModel, connectionId: siblingAccount.id }]
+        : []),
+      { model: fallbackModel, connectionId: fallbackAccount.id },
+    ],
+    config: {
+      maxRetries: 0,
+      maxSetRetries: 0,
+      failoverBeforeRetry: true,
+      retryDelayMs: 0,
+      fallbackDelayMs: 0,
+      targetTimeoutMs: 2000,
+      ...options.config,
+    },
+  };
+  if (options.cooldownRecovery) combo.models!.reverse();
+  if (options.pinHistory !== false) {
+    recordSessionModelUsage(
+      scopeHandoffSessionId(sessionId, null)!,
+      combo.name,
+      pinModel,
+      provider
+    );
+  }
+  const calls: Array<{ model: string; connectionId?: string; pinned: boolean }> = [];
+  const bindings: Array<{ connectionId?: string | null; allowedConnectionIds?: string[] | null }> =
+    [];
+  let aborted = 0;
+  let pinAttempts = 0;
+  let completedBodies = 0;
+  const controller = new AbortController();
+  if (options.abort === "before") controller.abort();
+  const startedAt = performance.now();
+  const result = await handleComboChat({
+    body: {
+      model: combo.name,
+      messages: [{ role: "user", content: `Continue isolated case ${tag}` }],
+      stream: false,
+      ...options.body,
+    },
+    combo,
+    allCombos: [combo],
+    log,
+    settings: options.cooldownRecovery
+      ? {
+          modelLockout: {
+            enabled: true,
+            errorCodes: [429],
+            baseCooldownMs: 150,
+            maxCooldownMs: 2000,
+            maxBackoffSteps: 0,
+            useExponentialBackoff: false,
+          },
+          resilienceSettings: {
+            comboCooldownWait: { enabled: true, maxWaitMs: 2000, maxAttempts: 1, budgetMs: 3000 },
+          },
+        }
+      : null,
+    relayOptions: { sessionId },
+    signal: controller.signal,
+    isModelAvailable: async () => true,
+    handleSingleModel: async (_body, model: string, target?: SingleModelTarget) => {
+      const accountTarget =
+        target && ("connectionId" in target || "modelPinned" in target) ? target : undefined;
+      calls.push({
+        model,
+        connectionId: accountTarget?.connectionId ?? undefined,
+        pinned: accountTarget?.modelPinned === true,
+      });
+      bindings.push({
+        connectionId: accountTarget?.connectionId,
+        allowedConnectionIds: accountTarget?.allowedConnectionIds,
+      });
+      if (options.cooldownRecovery) {
+        if (calls.filter((call) => call.model === model).length > 1) return response(200);
+        return Response.json(
+          {
+            error: { message: "Fixture rate limited" },
+            retryAfter: new Date(Date.now() + 1000).toISOString(),
+          },
+          { status: 429 }
+        );
+      }
+      if (model !== pinModel) {
+        if (options.holdFallback) {
+          return new Promise<Response>((_resolve, reject) => {
+            assert.ok(target?.modelAbortSignal);
+            const completion = options.fallbackCompleteMs
+              ? setTimeout(() => _resolve(response(200)), options.fallbackCompleteMs)
+              : undefined;
+            target.modelAbortSignal.addEventListener(
+              "abort",
+              () => {
+                clearTimeout(completion);
+                aborted += 1;
+                reject(new Error("fixture fallback aborted"));
+              },
+              { once: true }
+            );
+          });
+        }
+        return response(options.failFallback ? 503 : 200);
+      }
+      pinAttempts += 1;
+      if (
+        options.pinResult === "success" ||
+        pinAttempts === options.succeedPinOnAttempt ||
+        accountTarget?.connectionId === siblingAccount.id
+      )
+        return response(200);
+      if (options.pinDelayMs)
+        await new Promise((resolve) => setTimeout(resolve, options.pinDelayMs));
+      options.onPinAttempt?.();
+      if (options.abort === "during") controller.abort();
+      if (["slow-json", "slow-error", "silent-stream"].includes(options.pinResult ?? "")) {
+        const status = options.pinResult === "slow-error" ? 503 : 200;
+        const isStream = options.pinResult === "silent-stream";
+        const encoded = new TextEncoder().encode(
+          JSON.stringify(
+            status === 200
+              ? { choices: [{ message: { content: "Delayed body" } }] }
+              : { error: { message: "Delayed upstream failure" } }
+          )
+        );
+        let completion: ReturnType<typeof setTimeout> | undefined;
+        const delayedBody = new ReadableStream<Uint8Array>({
+          start(streamController) {
+            completion = setTimeout(
+              () => {
+                completedBodies += 1;
+                streamController.enqueue(encoded);
+                streamController.close();
+              },
+              isStream ? 3000 : 200
+            );
+            target?.modelAbortSignal?.addEventListener(
+              "abort",
+              () => {
+                clearTimeout(completion);
+                aborted += 1;
+                streamController.error(new Error("fixture body aborted"));
+              },
+              { once: true }
+            );
+          },
+          cancel() {
+            clearTimeout(completion);
+          },
+        });
