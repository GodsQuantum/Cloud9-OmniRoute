index 00000000..8ff51925
--- /dev/null
+++ b/open-sse/services/combo/contextPinAttempt.ts
@@ -0,0 +1,88 @@
+/**
+ * Match a completed context pin to the native target it consumed.
+ * A missing selected-account header is not evidence that every account in a
+ * union failed. Match the exact pool binding, or keep explicit sibling targets.
+ */
+import { withBodyTimeout } from "../../utils/stream.ts";
+import { errorResponse } from "../../utils/error.ts";
+import type { CompletedTargetAttempt } from "./attemptLoopTypes.ts";
+import type { ResolvedComboTarget } from "./types.ts";
+
+function accountPool(target: ResolvedComboTarget): string[] {
+  if (target.connectionId) return [target.connectionId];
+  return [...new Set(target.allowedConnectionIds ?? [])].sort();
+}
+
+function sameBinding(left: ResolvedComboTarget, right: ResolvedComboTarget): boolean {
+  const a = accountPool(left);
+  const b = accountPool(right);
+  return a.length === b.length && a.every((id, index) => id === b[index]);
+}
+
+export function prepareCompletedContextPin(
+  targets: ResolvedComboTarget[],
+  completed: CompletedTargetAttempt
+): { targets: ResolvedComboTarget[]; attempt: CompletedTargetAttempt } {
+  const pin = completed.target;
+  const selectedId =
+    completed.response.headers.get("X-OmniRoute-Selected-Connection-Id") || pin.connectionId;
+  const accountMatch = selectedId
+    ? targets.findIndex(
+        (target) => target.modelStr === pin.modelStr && target.connectionId === selectedId
+      )
+    : -1;
+  const match =
+    accountMatch >= 0
+      ? accountMatch
+      : targets.findIndex((target) => target.modelStr === pin.modelStr && sameBinding(target, pin));
+  const target: ResolvedComboTarget =
+    match >= 0
+      ? targets[match]
+      : {
+          ...pin,
+          executionKey: `${pin.executionKey}:completed-context-pin`,
+          connectionId: selectedId || null,
+          ...(selectedId ? { allowedConnectionIds: [selectedId] } : {}),
+        };
+  return {
+    targets: [target, ...targets.filter((_, index) => index !== match)],
+    attempt: { ...completed, target, unidentifiedConnection: match < 0 && !selectedId },
+  };
+}
+
+/**
+ * The pin's deadline includes health lookup, headers and response validation.
+ * Reuse the native body-timeout race, and abort the same provider signal when
+ * it wins; per-target and declared first-output budgets retain their own units.
+ */
+export async function runContextPinPrelude(args: {
+  run: (signal: AbortSignal) => Promise<Response | null>;
+  deadline: number | null;
+  signal?: AbortSignal | null;
+}): Promise<Response | null> {
+  if (args.signal?.aborted) return errorResponse(499, "Client disconnected");
+  const remaining = args.deadline === null ? null : args.deadline - Date.now();
+  const timeoutResponse = () =>
+    errorResponse(504, "Combo global timeout during context pin", {
+      code: "COMBO_TIMEOUT",
+      type: "server_error",
+    });
+  if (remaining !== null && remaining <= 0) return timeoutResponse();
+  const controller = new AbortController();
+  const signal = args.signal
+    ? AbortSignal.any([args.signal, controller.signal])
+    : controller.signal;
+  try {
+    const pending = args.run(signal);
+    const result = remaining === null ? await pending : await withBodyTimeout(pending, remaining);
+    if (args.signal?.aborted) {
+      void result?.body?.cancel().catch(() => {});
+      return errorResponse(499, "Client disconnected");
+    }
+    return result;
+  } catch (error) {
+    controller.abort(error);
+    if (error instanceof Error && error.name === "BodyTimeoutError") return timeoutResponse();
+    throw error;
+  }
+}
