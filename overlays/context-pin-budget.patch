+            "abort",
+            () => {
+              aborted += 1;
+              reject(new Error("fixture timeout aborted"));
+            },
+            { once: true }
+          );
+        });
+      }
+      const failed =
+        options.pinResult === "402"
+          ? Response.json(
+              { error: { message: "Credits exhausted", code: "credits_exhausted" } },
+              { status: 402 }
+            )
+          : options.pinResult === "429-quota"
+            ? Response.json(
+                { error: { message: "Subscription quota exhausted", code: "quota_exhausted" } },
+                { status: 429 }
+              )
+            : options.pinResult === "401"
+              ? Response.json({ error: { message: "Authentication expired" } }, { status: 401 })
+              : options.pinResult === "stall"
+                ? Response.json({
+                    object: "chat.completion",
+                    choices: [
+                      {
+                        index: 0,
+                        message: { role: "assistant", content: "Silent retry succeeded" },
+                        finish_reason: "stop",
+                      },
+                    ],
+                  })
+                : options.pinResult === "empty"
+                  ? new Response("", { headers: { "Content-Type": "application/json" } })
+                  : response(503);
+      if (options.selectedHeader) {
+        failed.headers.set("X-OmniRoute-Selected-Connection-Id", pinAccount.id);
+      }
+      return failed;
+    },
+  });
+  return {
+    result,
+    calls,
+    bindings,
+    aborted,
+    completedBodies,
+    pinModel,
+    fallbackModel,
+    pinAccount,
+    siblingAccount,
+    elapsedMs: performance.now() - startedAt,
+  };
+}
+
+test("a healthy context pin preserves affinity and its account binding", async () => {
+  const run = await runCase("healthy-pin", { pinResult: "success" });
+  assert.equal(run.result.status, 200);
+  assert.deepEqual(run.calls, [
+    { model: run.pinModel, connectionId: run.pinAccount.id, pinned: true },
+  ]);
+});
+
+test("an unpinned request still tries each target once with retries disabled", async () => {
+  const run = await runCase("without-pin", { pinHistory: false });
+  assert.equal(run.result.status, 200);
+  assert.deepEqual(
+    run.calls.map((call) => call.model),
+    [run.pinModel, run.fallbackModel]
+  );
+});
+
+test("a failed context pin advances to the healthy target without an extra retry", async () => {
+  const run = await runCase("status-503");
+  assert.equal(run.result.status, 200);
+  assert.deepEqual(
+    run.calls.map((call) => call.model),
+    [run.pinModel, run.fallbackModel]
+  );
+  assert.equal(run.calls[0].pinned, true);
+});
+
+test("a native pinned-target timeout advances without repeating the timed-out target", async () => {
+  const run = await runCase("native-timeout", {
+    pinResult: "timeout",
+    config: { targetTimeoutMs: 25 },
+  });
+  assert.equal(run.result.status, 200);
+  assert.deepEqual(
+    run.calls.map((call) => call.model),
+    [run.pinModel, run.fallbackModel]
+  );
+  assert.equal(run.aborted, 1);
+});
+
+test("the context-pin attempt consumes the configured global-attempt budget", async () => {
+  const run = await runCase("global-cap", { config: { maxGlobalAttempts: 1 } });
+  assert.equal(run.result.ok, false);
+  assert.deepEqual(
+    run.calls.map((call) => call.model),
+    [run.pinModel]
+  );
+});
+
+test("time spent in the failed context pin consumes the combo deadline", async (t) => {
+  let now = Date.now();
+  t.mock.method(Date, "now", () => now);
+  const run = await runCase("deadline", {
+    config: { comboTimeoutMs: 50 },
+    onPinAttempt: () => {
+      now += 100;
